{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.cheremha.ru/:path*" },
    { "source": "/agent-service/:path*", "destination": "https://api.cheremha.ru/agent-service/:path*" },
    { "source": "/((?!api/|agent-service/).*)", "destination": "/index.html" }
  ]
}
